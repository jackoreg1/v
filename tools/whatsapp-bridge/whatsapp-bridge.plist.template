<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- install.sh fills in __INSTALL_DIR__ and saves this to ~/Library/LaunchAgents. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.whatsapp-bridge.readonly</string>
  <key>ProgramArguments</key>
  <array>
    <string>__INSTALL_DIR__/whatsapp-bridge/whatsapp-bridge</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__INSTALL_DIR__/whatsapp-bridge</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>60</integer>
  <key>StandardOutPath</key>
  <string>__INSTALL_DIR__/bridge.log</string>
  <key>StandardErrorPath</key>
  <string>__INSTALL_DIR__/bridge.log</string>
</dict>
</plist>
